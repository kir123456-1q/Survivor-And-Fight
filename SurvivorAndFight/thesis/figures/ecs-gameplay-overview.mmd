%% 图4-2 GamePlay 实现（第4.2.1节）
flowchart TB
  subgraph Truth["ECS 数据 · 配表"]
    CORE["EntityId · ComponentStore Map<br/>Position · Velocity · Attribute · Skill"]
    CFG["Skill · SkillEffect · EffectExecutor<br/>FormulaParser 白名单 · 禁 eval"]
  end

  subgraph SysLayer["System 层（无状态）"]
    MV["MovementSystem · BulletSystem 等<br/>遍历实体 · 只改组件字段"]
  end

  GRP["EcsWorld · input → logic → render"]

  subgraph Filter["标签与筛选"]
    TAG["PlayerTag / MonsterTag 区分身份"]
    FR["FilterRegistry · Players · Monsters"]
  end

  subgraph Combat["战斗数据流"]
    PRE["CombatDataPrepareSystem · 坐标快照"]
    BR["CombatDataBridge → Worker processCombatFrame"]
    MCS["MonsterChaseSystem · 写回 Velocity"]
    BS["BulletSystem · 主线程 · Laya 节点 · 阵营"]
  end

  PAU["GameSession.paused<br/>Tab · 死亡 · 胜利 → logic 跳过"]

  TAG --> FR
  FR --> MV
  FR --> PRE
  GRP --> MV
  GRP --> PRE
  MV --> CORE
  CFG --> CORE
  PRE --> BR
  BR --> MCS
  MCS --> BS
  BS --> CORE
  PAU -.-> GRP

  EXT["增组件或 System · 无 MonsterBase 继承树"] -.-> CORE

    MB[MetaMenuBootstrap 注册路由]
    SP[StartPanel / SelectLevel / RunMap]
  end

  subgraph CombatUI["局内 UI"]
    TAB[SkillSelectPanelController<br/>Tab → paused=true]
    DRG[SkillDragService + SkillSlotHitTest]
    SYN[SkillLoadoutSyncSystem 写回]
    HUD[MainHud / BloodBarSync]
  end

  C --> M
  M --> ECS
  M --> MAP
  C --> V
  STK --> C
  MB --> STK
  SP --> C

  TAB --> ECS
  DRG --> SYN

flowchart TB
  subgraph Truth["玩法真相（ECS + 配表）"]
    ECS["Attribute / Skill / GameSession<br/>SkillLoadoutState"]
    MAP["RunMapState / 跑图图结构"]
  end

  subgraph MVC["MVC 变体"]
    M["Model<br/>RunMapPanelModel 等"]
    V["View<br/>预制体 + UI2 布局"]
